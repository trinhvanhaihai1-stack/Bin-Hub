-- ===== LOGIC HITBOX (RunService Update) =====
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

local ballHitbox = nil
local playerHitboxes = {}  -- {player = hitboxPart}

-- Tìm Ball (Blue Lock style: workspace.Ball or find)
local function findBall()
   for _, obj in ipairs(workspace:GetChildren()) do
      if obj.Name:lower():find("ball") and obj:IsA("BasePart") then
         return obj
      end
   end
   return workspace:FindFirstChild("Ball")
end

-- Update Ball Hitbox
local function updateBallHitbox()
   if not BallEnabled[1] then
      if ballHitbox then
         ballHitbox:Destroy()
         ballHitbox = nil
      end
      return
   end
   
   local ball = findBall()
   if not ball then return end
   
   if not ballHitbox then
      ballHitbox = Instance.new("Part")
      ballHitbox.Name = "BallHitboxESP"
      ballHitbox.Shape = Enum.PartType.Ball  -- VÒNG TRÒN
      ballHitbox.Size = Vector3.new(BallSize[1], BallSize[1], BallSize[1])
      ballHitbox.Transparency = BallTransparency[1]
      ballHitbox.Color = BallColor[1]
      ballHitbox.Material = Enum.Material.ForceField  -- Glow trắng như hình
      ballHitbox.CanCollide = false
      ballHitbox.Anchored = false
      ballHitbox.Parent = workspace.CurrentCamera  -- Client-side ESP
   else
      ballHitbox.Size = Vector3.new(BallSize[1], BallSize[1], BallSize[1])
      ballHitbox.Transparency = BallTransparency[1]
      ballHitbox.Color = BallColor[1]
   end
   
   -- Theo ball
   ballHitbox.CFrame = ball.CFrame
end

-- Update Player Hitboxes
local function updatePlayerHitboxes()
   if not PlayerEnabled[1] then
      for _, hitbox in pairs(playerHitboxes) do
         if hitbox then hitbox:Destroy() end
      end
      playerHitboxes = {}
      return
   end
   
   for _, plr in ipairs(Players:GetPlayers()) do
      if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
         local root = plr.Character.HumanoidRootPart
         if not playerHitboxes[plr] then
            local hitbox = Instance.new("Part")
            hitbox.Name = plr.Name .. "HitboxESP"
            hitbox.Shape = Enum.PartType.Block  -- HÌNH VUÔNG
            hitbox.Size = Vector3.new(PlayerSize[1], PlayerSize[1], PlayerSize[1])
            hitbox.Transparency = PlayerTransparency[1]
            hitbox.Color = PlayerColor[1]
            hitbox.Material = Enum.Material.ForceField
            hitbox.CanCollide = false
            hitbox.Anchored = false
            hitbox.Parent = workspace.CurrentCamera
            playerHitboxes[plr] = hitbox
         else
            local hitbox = playerHitboxes[plr]
            hitbox.Size = Vector3.new(PlayerSize[1], PlayerSize[1], PlayerSize[1])
            hitbox.Transparency = PlayerTransparency[1]
            hitbox.Color = PlayerColor[1]
         end
         
         -- Offset Dive như hình
         playerHitboxes[plr].CFrame = root.CFrame * CFrame.new(0, 0, PlayerOffset[1])
      end
   end
end

-- Auto Steal Logic (Hack dính bóng khi gần)
local lastSteal = 0
local function autoSteal()
   if not AutoSteal[1] then return end
   local now = tick()
   if now - lastSteal < 0.5 then return end  -- Cooldown
   
   local ball = findBall()
   if not ball then return end
   
   local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
   if not root then return end
   
   local dist = (root.Position - ball.Position).Magnitude
   if dist < 30 then  -- Gần bóng <30 studs
      -- Fire steal remote (Blue Lock remotes - adjust nếu biết)
      -- Ví dụ: game.ReplicatedStorage.Remotes.StealBall:FireServer()
      -- Hoặc velocity hack
      local bv = Instance.new("BodyVelocity")
      bv.MaxForce = Vector3.new(1e6, 0, 1e6)
      bv.Velocity = (root.Position - ball.Position).Unit * 100
      bv.Parent = ball
      game:GetService("Debris"):AddItem(bv, 0.2)
      
      lastSteal = now
   end
end

-- MAIN LOOP
RunService.Heartbeat:Connect(function()
   updateBallHitbox()
   updatePlayerHitboxes()
   autoSteal()
end)

-- Cleanup on leave
Players.PlayerRemoving:Connect(function(plr)
   if playerHitboxes[plr] then
      playerHitboxes[plr]:Destroy()
      playerHitboxes[plr] = nil
   end
end)

