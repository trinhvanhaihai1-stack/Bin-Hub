--- LOGIC HITBOX FIX LÚN (HIPHEIGHT OFFSET) ---
local function ApplySoloHitbox()
    task.spawn(function()
        while _G.HitboxEnabled do
            local lp = game:GetService("Players").LocalPlayer
            if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") and lp.Character:FindFirstChild("Humanoid") then
                local hrp = lp.Character.HumanoidRootPart
                local hum = lp.Character.Humanoid
                
                -- SỬA LỖI LÚN: Nâng HipHeight dựa trên Size Hitbox
                if _G.MyHitboxSize > 2 then
                    hum.HipHeight = _G.MyHitboxSize / 2
                else
                    hum.HipHeight = 2 -- Mặc định
                end
                
                hrp.Size = Vector3.new(_G.MyHitboxSize, _G.MyHitboxSize, _G.MyHitboxSize)
                hrp.Transparency = 0.8
                hrp.BrickColor = BrickColor.new("Steel blue")
                hrp.CanCollide = false -- Tắt va chạm để không bị bắn vọt lên trời
            end
            
            -- Hitbox Bóng Màu Đỏ
            for _, obj in pairs(game.Workspace:GetDescendants()) do
                if obj:IsA("BasePart") and (obj.Name == "Ball" or obj.Name == "Football") then
                    obj.Size = Vector3.new(_G.BallHitboxSize, _G.BallHitboxSize, _G.BallHitboxSize)
                    obj.BrickColor = BrickColor.new("Bright red")
                    obj.Transparency = 0.6
                end
            end
            task.wait(0.5)
        end
    end)
end

--- AUTO GK LOGIC (TỰ ĐỘNG BẮT TRONG VÙNG) ---
task.spawn(function()
    while task.wait() do
        if _G.AutoGK then
            local lp = game:GetService("Players").LocalPlayer
            local ball = nil
            for _, obj in pairs(game.Workspace:GetDescendants()) do
                if obj.Name == "Ball" or obj.Name == "Football" then ball = obj break end
            end
            
            if ball and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = lp.Character.HumanoidRootPart
                local dist = (hrp.Position - ball.Position).Magnitude
                if dist < _G.GKDistance then
                    -- Quay mặt về bóng và di chuyển nhẹ tới bóng
                    hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(ball.Position.X, hrp.Position.Y, ball.Position.Z))
                    if dist > 2 then
                        hrp.Velocity = (ball.Position - hrp.Position).Unit * 50
                    end
                end
            end
        end
    end
end)

--- GIAO DIỆN MAIN ---
MainTab:CreateToggle({
