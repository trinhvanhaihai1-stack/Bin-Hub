--- LOGIC HACK (MƯỢT MÀ) ---
local function ApplyHitboxLogic()
    task.spawn(function()
        while _G.HitboxEnabled do
            -- Người (Hình Hộp)
            for _, player in pairs(game:GetService("Players"):GetPlayers()) do
                if player ~= game:GetService("Players").LocalPlayer and player.Character then
                    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.Size = Vector3.new(_G.HitboxSize, _G.HitboxSize, _G.HitboxSize)
                        hrp.Transparency = 0.7
                        hrp.BrickColor = BrickColor.new("Steel blue")
                        hrp.Material = Enum.Material.ForceField
                        hrp.CanCollide = false
                    end
                end
            end
            -- Bóng (Hình Tròn)
            for _, obj in pairs(game.Workspace:GetDescendants()) do
                if obj:IsA("BasePart") and (obj.Name == "Ball" or obj.Name == "Football" or obj:FindFirstChild("BallScript")) then
                    obj.Shape = Enum.PartType.Ball
                    obj.Size = Vector3.new(_G.BallHitboxSize, _G.BallHitboxSize, _G.BallHitboxSize)
                    obj.Transparency = 0.5
                    obj.BrickColor = BrickColor.new("Cyan")
                    obj.Material = Enum.Material.ForceField
                    obj.CanCollide = false
                end
            end
            task.wait(0.3)
        end
    end)
end

task.spawn(function()
    while task.wait(0.5) do
        if _G.InfStamina then
            local lp = game:GetService("Players").LocalPlayer
            if lp.Character then
                for _, v in pairs(lp.Character:GetDescendants()) do
                    if (v:IsA("NumberValue") or v:IsA("IntValue")) and string.find(v.Name:lower(), "stamina") then
                        v.Value = 100
                    end
                end
            end
        end
    end
end)

