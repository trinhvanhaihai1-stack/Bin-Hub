local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "Bin Hub | Blue Lock Final Fix",
    LoadingTitle = "Rayfield UI System",
    LoadingSubtitle = "by trinhvanhai21",
    ConfigurationSaving = {Enabled = true, FolderName = "BinHubConfigs", FileName = "SoloConfigFix"}
})

-- Biến cấu hình
_G.MyHitboxSize = 22
_G.BallHitboxSize = 22
_G.HitboxEnabled = false
_G.InfStamina = false
_G.MusicVolume = 2
_G.CustomHipHeight = 2 -- Độ cao mặc định

-- Tab
local MainTab = Window:CreateTab("Main ⚽", 4483362458)
local FixTab = Window:CreateTab("Sửa Lỗi 🔧", 4483362458)
local MusicTab = Window:CreateTab("Music 🎶", 4483362458)

--- LOGIC HITBOX ---
local function ApplySoloHitbox()
    task.spawn(function()
        while _G.HitboxEnabled do
            local lp = game:GetService("Players").LocalPlayer
            if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") and lp.Character:FindFirstChild("Humanoid") then
                local hrp = lp.Character.HumanoidRootPart
                local hum = lp.Character.Humanoid
                
                -- Áp dụng độ cao từ thanh trượt
                hum.HipHeight = _G.CustomHipHeight
                
                -- Chỉnh Hitbox
                hrp.Size = Vector3.new(_G.MyHitboxSize, _G.MyHitboxSize, _G.MyHitboxSize)
                hrp.Transparency = 0.8
                hrp.BrickColor = BrickColor.new("Steel blue")
                hrp.CanCollide = false 
                hrp.Massless = true -- Giúp nhân vật nhẹ hơn, đỡ bị lỗi vật lý
            end
            
            -- Hitbox Bóng (Đỏ)
            for _, obj in pairs(game.Workspace:GetDescendants()) do
                if obj:IsA("BasePart") and (obj.Name == "Ball" or obj.Name == "Football") then
                    obj.Size = Vector3.new(_G.BallHitboxSize, _G.BallHitboxSize, _G.BallHitboxSize)
                    obj.BrickColor = BrickColor.new("Bright red")
                    obj.Transparency = 0.6
                end
            end
            task.wait(0.5)
        end
    end)
end

--- GIAO DIỆN CHÍNH ---
MainTab:CreateToggle({
    Name = "Kích hoạt Hitbox (Bạn & Bóng)",
    CurrentValue = false,
    Callback = function(Value)
        _G.HitboxEnabled = Value
        if Value then 
            ApplySoloHitbox() 
        else
            -- Reset về mặc định khi tắt
            local lp = game:GetService("Players").LocalPlayer
            if lp.Character and lp.Character:FindFirstChild("Humanoid") then
                lp.Character.Humanoid.HipHeight = 2 -- Reset chiều cao
                lp.Character.HumanoidRootPart.Size = Vector3.new(2, 2, 1)
            end
        end
    end,
})

MainTab:CreateSlider({
    Name = "Size Hitbox Bạn",
    Range = {2, 25},
    Increment = 1,
    CurrentValue = 22,
    Callback = function(Value) _G.MyHitboxSize = Value end,
})

MainTab:CreateSlider({
